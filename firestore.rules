rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Strict isolation rules for employee accounts
    match /profiles_employee/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Strict isolation rules for employer accounts
    match /profiles_employer/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
